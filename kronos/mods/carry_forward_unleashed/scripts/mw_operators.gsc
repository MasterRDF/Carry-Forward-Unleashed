// MW Operators (kronos\mods\mw_operators), built by mw_operator_poc/tools/build_mod.mjs from operators.json.
// Kronos' stock mp_bo6_operators.gsc builds level.bo6ops_refs/_first/_count/_skins in mp_bo6_ops_data(), and only
// if level.bo6ops_refs is not defined yet. This puts all four in place holding Kronos' 66 BO6 operators followed
// by the 128 added ones (#67-#194, 661 added skins).
// Kronos' script links before mod scripts, and its early pass (mp_bo6_ops_early) runs inside its autoexec when the
// match data is already there: it registers its 66 with the engine before this autoexec runs. R45: leaving the
// rest to Kronos' later pass (mp_bo6_ops_main) made the engine refuse 192 of 194 operators (robot model). So when
// that early pass is already done, this registers the added operators itself, in the same frame and order, as the
// early pass does on a patched mp_bo6_operators.gsc.
// Needs the patched XINPUT9_1_0.dll (operator and skin tables enlarged past 72/434).
#using script_2dc447b1dd033a26;

autoexec mw_operators_init()
{
    if (!isdefined(level.bo6ops_refs))
    {
        mw_operators_data();
        level.mwops_mode = "set first";
        return;
    }
    if (level.bo6ops_refs.size != 66)
    {
        level.mwops_mode = "left alone";
        return;
    }
    mw_operators_data();
    level.mwops_mode = "replaced stock";
    if (isdefined(level.bo6ops_early_done))
    {
        mw_operators_early_add();
        level.mwops_mode = "replaced stock, added early";
    }
}

// mp_bo6_ops_early's loop, for the added operators only
mw_operators_early_add()
{
    i = 66;
    while (i < level.bo6ops_refs.size)
    {
        ref = level.bo6ops_refs[i];
        if (!mw_operators_inlist(ref))
        {
            if (isdefined(function_d31f72cf98934929(ref)))
            {
                operator::function_449035ab2454100(ref);
                level.bo6ops_early_added = level.bo6ops_early_added + 1;
            }
            else
            {
                level.bo6ops_early_nodata = level.bo6ops_early_nodata + 1;
            }
        }
        i = i + 1;
    }
}

mw_operators_inlist(opref)
{
    list = operator::function_91f90d6f14a0f260();
    j = 0;
    while (j < list.size)
    {
        if (list[j] == opref)
        {
            return 1;
        }
        j = j + 1;
    }
    return 0;
}

